# ═══════════════════════════════════════════════════════════════════════════════
# Compliance Copilot — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=local
# Options: local | staging | production

# ── Database ──────────────────────────────────────────────────────────────────
# Local demo credentials consumed by Docker Compose. Replace outside demo use.
POSTGRES_USER=compliance
POSTGRES_PASSWORD=compliance
POSTGRES_DB=compliance
DATABASE_URL=postgresql+psycopg://compliance:compliance@db:5432/compliance
# For local dev without Docker: postgresql+psycopg://postgres:postgres@localhost:5432/compliance

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-generate-with-python-secrets-token-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── AI Provider ───────────────────────────────────────────────────────────────
# "mock" works fully offline without any API key (default for development)
# "openai" requires OPENAI_API_KEY below. Embeddings only refine BM25 results.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
